# ==============================================================================
# Multi-stage Dockerfile for Next.js Web Management Console
# Builds static output with hoisted node_modules outside the app folder,
# then serves high-performance static files through Nginx.
# ==============================================================================

# Stage 1: Build static Next.js export
FROM node:20-alpine AS builder

WORKDIR /workspace

# Install system dependencies if required for node-gyp
RUN apk add --no-cache libc6-compat

# Copy root workspace and web package definitions
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/

# Install dependencies (hoisted to root /workspace/node_modules)
RUN npm ci

# Copy web application source code
COPY apps/web ./apps/web

# Build static HTML export (outputs to apps/web/out)
WORKDIR /workspace/apps/web
ENV NEXT_PUBLIC_BASE_PATH=""
RUN npm run build

# Stage 2: Production Nginx Server
FROM nginx:1.25-alpine

# Remove default nginx html
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static export from builder stage
COPY --from=builder /workspace/apps/web/out /usr/share/nginx/html

# Copy custom Nginx configuration
COPY infrastructure/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
