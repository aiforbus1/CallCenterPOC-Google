# ============================================================
# AI Call Center POC — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://callcenter:callcenter@localhost:5432/callcenterdb
DATABASE_SYNC_URL=postgresql://callcenter:callcenter@localhost:5432/callcenterdb

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
JWT_SECRET=change-this-to-a-random-256-bit-secret-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OpenRouter (All AI Models) ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_CHAT_MODEL=google/gemini-2.0-flash-001
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Call Center POC

# --- TTS Configuration ---
TTS_VOICE=en-US-Standard-A
TTS_RESPONSE_FORMAT=mp3

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret-here

# --- Public URLs (used by Twilio for webhooks) ---
PUBLIC_API_BASE_URL=https://your-ngrok-or-public-url.example.com
PUBLIC_WEB_BASE_URL=http://localhost:3000
PUBLIC_MEDIA_WEBSOCKET_URL=wss://your-ngrok-or-public-url.example.com

# --- Call Modes ---
# Set to 'simulated' to run without Twilio credentials.
# Set to 'twilio' for real telephone calls.
TELEPHONY_PROVIDER=simulated

# --- Recording ---
RECORDING_ENABLED=true
RECORDING_RETENTION_DAYS=30

# --- Outbound Call Restrictions ---
# Comma-separated E.164 numbers allowed for outbound during development.
# Leave empty to allow all (NOT recommended for production).
ALLOWED_OUTBOUND_DESTINATIONS=

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
