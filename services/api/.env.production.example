# ==============================================================================
# AI Call Center 122 — Namecheap Production Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Rename this file to .env on your Namecheap hosting account.
# 2. Fill in your PostgreSQL database credentials and API keys.
# 3. For Namecheap Shared Hosting, use a cloud-hosted PostgreSQL (e.g. Neon, Supabase, Render, Aiven).
# 4. For Namecheap VPS / Dedicated, you can use local PostgreSQL (localhost:5432).
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Allowed CORS Origins ---
# Add your Namecheap domain, frontend domain, and mobile app URLs
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com,http://localhost:3000

# --- PostgreSQL Database ---
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>?ssl=require
# Examples:
# Neon / Supabase Cloud DB:
# DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_xxxx@ep-cool-fog-1234.us-east-2.aws.neon.tech/neondb?ssl=require
# DATABASE_SYNC_URL=postgresql://neondb_owner:npg_xxxx@ep-cool-fog-1234.us-east-2.aws.neon.tech/neondb?ssl=require
#
# Local PostgreSQL (VPS):
DATABASE_URL=postgresql+asyncpg://callcenter_user:STRONG_PASSWORD_HERE@localhost:5432/callcenter_db
DATABASE_SYNC_URL=postgresql://callcenter_user:STRONG_PASSWORD_HERE@localhost:5432/callcenter_db

# --- Security / JWT Secret ---
# Generate a random 64-character string for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_256_BIT_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- OpenRouter AI API ---
# Used for Whisper STT, Gemini Voice TTS, and Emergency Triage Chat
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=openai/whisper-large-v3
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=https://yourdomain.com
OPENROUTER_APP_NAME=Police 122 AI Emergency POC

# --- TTS Voice Configuration ---
TTS_VOICE=Aoede
TTS_RESPONSE_FORMAT=wav

# --- Telephony Configuration ---
# Options: 'simulated' (for in-app/mobile VoIP without Twilio charges) or 'twilio'
TELEPHONY_PROVIDER=simulated

# If using real Twilio calls, populate these:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# --- Public Domain URLs ---
PUBLIC_API_BASE_URL=https://api.yourdomain.com
PUBLIC_WEB_BASE_URL=https://yourdomain.com
PUBLIC_MEDIA_WEBSOCKET_URL=wss://api.yourdomain.com

# --- Call Audio Recording ---
RECORDING_ENABLED=true
RECORDING_RETENTION_DAYS=30
ALLOWED_OUTBOUND_DESTINATIONS=
